{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "post"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "post"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "read-pre"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "session-start"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "stop"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/guard.js", "session-end"],
            "timeout": 15,
            "statusMessage": "tokenbrake"
          }
        ]
      }
    ]
  }
}
